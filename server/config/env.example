# ============================================================
# myLLM 로컬 서빙 환경설정 (복사본을 만들 것)
#    사용법: cp server/config/env.example server/config/env
#            # 필요시 편집 후
#            source server/config/env
# ============================================================

# --- 바인딩 / 포트 ---
# 리스닝 주소. 원격 VS Code 가 접속하므로 0.0.0.0 으로 열어야 LAN 접근 가능.
export LLAMA_HOST="0.0.0.0"
export LLAMA_PORT="8080"

# --- 모델 ---
# GGUF 저장소 및 파일명 (아래 2개 중 택1, 파일명과 일치해야 함)
# 1) unsloth:        https://huggingface.co/unsloth/Qwen3.5-27B-GGUF
#    -> 파일명을 unsloth 페이지에서 확인 후 아래 MODEL_FILE 에 그대로 지정
# 2) mradermacher:   https://huggingface.co/mradermacher/Qwen3.5-27B-GGUF
#    -> Qwen3.5-27B.Q4_K_M.gguf  (16.6 GB)
export HF_REPO="mradermacher/Qwen3.5-27B-GGUF"
export MODEL_FILE="Qwen3.5-27B.Q4_K_M.gguf"

# 로컬 모델 저장 디렉토리
export MODEL_DIR="${HOME}/models"

# --- 추론 파라미터 ---
# CPU 이므로 컨텍스트를 현실적으로. (네이티브는 256K지만 CPU에선 비추)
export CTX_SIZE="16384"
# 사고 토큰 <think> 끄기 (CPU 지연 감소)  1=끔
export NO_THINK="1"
# 사용할 CPU 스레드 (0 = 자동. 9700X는 16스레드 정도)
export THREADS="0"
# 배치/UBatch 크기
export BATCH="512"
export UBATCH="512"

# --- 병렬 배치 동시 사용자 (보통 1) ---
export PARALLEL="1"

# --- llama.cpp 설치 위치 (빌드 스크립트가 사용/생성) ---
export LLAMA_CPP_DIR="${HOME}/llama.cpp"
