# ============================================================
# myLLM 로컬 서빙 환경설정 (복사본을 만들 것)
#    사용법: cp server/config/env.example server/config/env
#            # 필요시 편집 후
#            source server/config/env
# ============================================================

# --- 바인딩 / 포트 ---
# 리스닝 주소. 원격 VS Code 가 접속하므로 0.0.0.0 으로 열어야 LAN 접근 가능.
export LLAMA_HOST="0.0.0.0"
export LLAMA_PORT="8080"

# --- 모델 ---
# GGUF 저장소 및 파일명 (사용자 선택: unsloth Qwen3-Coder-30B-A3B-Instruct)
#   https://huggingface.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF
#   - MoE: 총 ~30B 지만 토큰당 활성 ~3B -> CPU 8코어에서도 비교적 빠름
#   - arch = qwen3moe (llama.cpp 안정 지원), 컨텍스트 네이티브 262144
#   - imatrix 캘리브레이션, apache-2.0
export HF_REPO="unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF"
export MODEL_FILE="Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
#   (≈18.6 GB, 64GB RAM 에 넉넉히 fit. 다른 양자화: IQ4_XS / Q5_K_M 등)

# 로컬 모델 저장 디렉토리
export MODEL_DIR="${HOME}/models"

# --- 추론 파라미터 ---
# 이 모델은 네이티브 256K 컨텍스트지만 coder/채팅 용도엔 보통 16~32K 로 충분.
# 필요시 올리세요 (64GB RAM, MoE KV 캐시가 작아 넉넉).
export CTX_SIZE="32768"
# 사고/추론 토큰 제어: 이 Coder-Instruct 모델은 기본적으로 thinking 을 강제하지 않으므로
# 보통 0(플래그 안 넣음 = 안전) 으로 둔다. 만약 응답에 chain-of-thought 가 길게 나와 불편하면
# 1 로 바꿔 suppress 하세요. (--no-think 는 최신 llama.cpp 에서만 지원 — 구버전은 시작 실패 가능)
export NO_THINK="0"
# 사용할 CPU 스레드 (0 = 자동. 9700X는 8코어/16스레드, 8~12 사이 실측 권장)
export THREADS="0"
# 배치/UBatch 크기 (prompt 처리량 향상)
export BATCH="512"
export UBATCH="512"

# --- 병렬 배치 동시 사용자 (보통 1) ---
export PARALLEL="1"

# --- llama.cpp 설치 위치 (빌드 스크립트가 사용/생성) ---
export LLAMA_CPP_DIR="${HOME}/llama.cpp"
