# ============================================================
# myLLM 로컬 서빙 환경설정 (복사본을 만들 것)
#    사용법: cp server/config/env.example server/config/env
#            # 필요시 편집 후
#            source server/config/env
# ============================================================

# --- 바인딩 / 포트 ---
# 리스닝 주소. 원격 VS Code 가 접속하므로 0.0.0.0 으로 열어야 LAN 접근 가능.
export LLAMA_HOST="0.0.0.0"
export LLAMA_PORT="8080"

# --- HuggingFace 토큰 (다운로드 속도/인증 개선, 선택) ---
# 다운로드 스크립트가 순서대로 찾는다:
#   1) 이 파일에서 export HF_TOKEN=...
#   2) server/config/hf_token 파일 (gitignore 대상 - 비밀노출 방지)
#   3) ~/.cache/huggingface/token  (huggingface-cli login 으로 만들어진 것)
# 방법: https://huggingface.co/settings/tokens 에서 읽기(Read) 토큰 생성 후
#       이 변수 또는 hf_token 파일에 넣으세요. (private repo 열람 + 대역폭/속도 개선)
export HF_TOKEN=""

# --- GGUF 다운로드 옵션 ---
# 기본은 단일 스트림 + 이어받기(resume). 대역폭 병렬분할은 HF CDN 특성상 큰 효과 없어 권장 안 함.
export HF_DL_THREADS=""   # 예: "4" (실험적, aria2c 없으면 비워둘 것)

# --- 모델 ---
# GGUF 저장소 및 파일명 (사용자 선택: DeepSeek-R1-Distill-Qwen-1.5B)
#   https://huggingface.co/unsloth/DeepSeek-R1-Distill-Qwen-1.5B-GGUF
#   - 1.5B (Qwen2 arch qwen2 기반 DeepSeek R1 증류 reasoning 모델)
#   - llama.cpp arch qwen2 -> 표준/안정 지원 (아키텍처 우려 없음)
#   - 가벼움: Q4_K_M ≈ 1.0 GB -> 9700X CPU 에서 매우 빠름 (속도 우선)
#   - 컨텍스트 네이티브 131072. 템플릿은 DeepSeek 형식(<|User｜>/<think>)
export HF_REPO="unsloth/DeepSeek-R1-Distill-Qwen-1.5B-GGUF"
export MODEL_FILE="DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf"

# 로컬 모델 저장 디렉토리
export MODEL_DIR="${HOME}/models"

# --- 추론 파라미터 ---
# 1.5B 고속(속도 우선) 모델. VS Code 채팅/가벼운 편집용 컨텍스트.
export CTX_SIZE="32768"
# DeepSeek-R1 distill 은 reasoning(<think>) 모델로, 생각을 항상 먼저 출력 -> 응답이 길어지고 느려짐.
# 속도 최우선이면 1 로 억제를 시도할 수 있으나(품질 저하 유의), 기본 0 으로 둠.
export NO_THINK="0"
# 사용할 CPU 스레드 (0 = 자동. 9700X는 8코어/16스레드, 8~12 사이 실측 권장)
export THREADS="0"
# 배치/UBatch 크기 (prompt 처리량 향상)
export BATCH="512"
export UBATCH="512"

# --- 병렬 배치 동시 사용자 (보통 1) ---
export PARALLEL="1"

# --- llama.cpp 설치 위치 (빌드 스크립트가 사용/생성) ---
export LLAMA_CPP_DIR="${HOME}/llama.cpp"
