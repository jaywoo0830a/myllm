# ============================================================
# myLLM 로컬 서빙 환경설정 - 공통(base)
#   사용법: cp server/config/env.example server/config/env
#            source server/config/env
#
#   [중요] 이 파일은 여러 모델에 공통으로 쓰는 BASE 값.
#   모델별 설정은 server/config/models/<slug>.env(.example) 에 둔다.
#   slug 예: deepseek-r1-32b  (현재 유일 모델)
# ============================================================

# --- 바인딩 (모든 모델 공통) ---
# 원격 VS Code 가 접속하므로 0.0.0.0 으로 열어야 LAN 접근 가능.
export LLAMA_HOST="0.0.0.0"

# --- HuggingFace 토큰 (다운로드 속도/인증 개선, 선택) ---
# 다운로드 스크립트는 순서대로 찾는다:
#   1) 이 파일에서 export HF_TOKEN=...
#   2) server/config/hf_token 파일 (gitignore 대상 - 비밀노출 방지)
#   3) ~/.cache/huggingface/token  (huggingface-cli login 산출물)
# https://huggingface.co/settings/tokens 에서 Read 토큰 생성 후 여기 또는 hf_token 파일.
export HF_TOKEN=""

# --- GGUF 다운로드 옵션 ---
export HF_DL_THREADS=""   # 예: "4" (aria2c 병렬분할, 비워두면 단일+이어받기)

# --- 로컬 경로 (공통) ---
# 모델 GGUF 저장 디렉토리
export MODEL_DIR="${HOME}/models"
# llama.cpp 설치 위치 (01 빌드 스크립트 사용)
export LLAMA_CPP_DIR="${HOME}/llama.cpp"

# ============================================================
# 모델 (config/models/*.env 를 로드해 데몬으로 띄운다)
#   현재 유일 모델: deepseek-r1-32b -> 포트 8081
#
# 각 model env 는 아래 변수를 정의할 수 있다 (이 base 위에 덮어씀):
#   MODEL_NAME, ALIAS, HF_REPO, MODEL_FILE, LLAMA_PORT,
#   CTX_SIZE, THREADS, NO_THINK, PARALLEL, BATCH, UBATCH, KV_CACHE
#   * KV_CACHE: 예 "q8_0" -> --cache-type k:q8_0,v:q8_0 (대역폭 절약)
# 사용 가능한 모델은 server/config/models/*.env 에서 확인.
# ============================================================
# (선택) run_all.sh / lib.sh 가 쓰는 기본값. 모델별 세부값은 config/models/*.env 에서 지정.
export NO_THINK="0"
export CTX_SIZE="16384"
export THREADS="0"
export BATCH="512"
export UBATCH="512"
export PARALLEL="1"

