# ============================================================
# 모델 프로파일: DeepSeek-R1-Distill-Qwen-14B  (유일 모델)
#   server/config/models/deepseek-r1-14b.env 로 복사해서 사용.
#   slug = deepseek-r1-14b
#   (이 프로파일 단독으로 운영. 다른 모델 프로파일 없음)
#
# 전역 config/env 를 source 한 뒤 이어서 로드된다 (같은 변수 덮어씀).
# ============================================================

# 모델 slug (systemd @인스턴스명, 파일명과 일치)
MODEL_NAME="deepseek-r1-14b"

# 표시용/API alias (llama-server --alias 로 /v1/models 에 노출)
ALIAS="deepseek-r1-14b"

# GGUF 정보 (unsloth 커뮤니티 GGUF; 공식 deepseek GGUF 리포는 비공개 401)
#   14B dense reasoning (기존 32B 대체 — 약 2배 빠름). arch = qwen2 (안정)
#   파일 ≈ 8.9 GB. R1 distill: 항상 <think> 먼저 출력 (NO_THINK 무효)
HF_REPO="unsloth/DeepSeek-R1-Distill-Qwen-14B-GGUF"
MODEL_FILE="DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf"

# 리스닝 포트 (유일 모델)
LLAMA_PORT="8081"

# 추론 파라미터 (단독 → 전체 머신 전용)
# 컨텍스트: CPU 에서 필요한 최소로 (크면 그만큼 느려짐)
CTX_SIZE="16384"
# 스레드 = 실제 물리 코어 수. 9700X = 8코어/16스레드(SMT).
#  dense 디코드는 대역폭 병목 → 하이퍼스레딩(16) 은 손해, 8(전 코어) 이 적정.
THREADS="8"
# KV 캐시 양자화: 대역폭 절약으로 디코드 소폭 개선 ("q8_0"). 버전 미지원 시 무시됨.
KV_CACHE="q8_0"
# R1-14B: reasoning 항상 출력, 억제 불가 (NO_THINK 무효) -> 0 유지
NO_THINK="0"
PARALLEL="1"
BATCH="512"
UBATCH="512"
