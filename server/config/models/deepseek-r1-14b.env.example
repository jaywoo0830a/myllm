# ============================================================
# Model profile: DeepSeek-R1-Distill-Qwen-14B (only model)
#   Copy server/config/models/deepseek-r1-14b.env for use.
#   slug = deepseek-r1-14b
#   (This profile runs alone – no other model profiles)
#
#   It is loaded after sourcing the global config/env (overwrites same variables).
# ============================================================

# Model slug (must match systemd instance name and file name)
MODEL_NAME="deepseek-r1-14b"

# Alias for the OpenAI‑compatible API (exposed via llama‑server --alias)
ALIAS="deepseek-r1-14b"

# GGUF information (unsloth community GGUF; official DeepSeek GGUF repo is private)
#   14B dense reasoning (replaces the original 32B, ~2× faster). Architecture = qwen2 (stable)
#   Approx. 8.9 GB file. R1 distill always outputs <think> first (NO_THINK ineffective)
HF_REPO="unsloth/DeepSeek-R1-Distill-Qwen-14B-GGUF"
MODEL_FILE="DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf"

# Listening port (only model)
LLAMA_PORT="8081"

# Inference parameters (dedicated to the whole machine)
#   Context size: keep minimal for CPU (larger → slower)
CTX_SIZE="16384"
#   Threads = physical cores. 9700X = 8 cores / 16 threads (SMT).
#   Dense decoding is bandwidth‑bound → hyper‑threading (16) hurts, 8 (full core) is optimal.
THREADS="8"
#   KV‑cache quantisation: saves bandwidth, slight decoding speedup ("q8_0"). Ignored if unsupported.
KV_CACHE="q8_0"
#   R1‑14B: reasoning always outputs, cannot be suppressed (NO_THINK ineffective) → keep 0
NO_THINK="0"
PARALLEL="1"
BATCH="512"
UBATCH="512"
