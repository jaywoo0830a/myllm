# ============================================================
# 모델 프로파일: DeepSeek-R1-Distill-Qwen-1.5B  (경량 보조)
#   server/config/models/<slug>.env 로 복사해서 사용.
#   slug = deepseek-1.5b   ->  config/models/deepseek-1.5b.env
#
# 이 파일은 전역 config/env 를 source 한 뒤 이어서 로드된다.
# (즉 여기서 같은 변수를 덮어쓰면 이 모델에만 적용)
# ============================================================

# 모델 slug (systemd @인스턴스명, 파일명과 일치)
MODEL_NAME="deepseek-1.5b"

# 표시용/API alias 용 이름 (llama-server --alias 로 /v1/models 에 노출)
ALIAS="deepseek-r1-1.5b"

# GGUF 정보
HF_REPO="unsloth/DeepSeek-R1-Distill-Qwen-1.5B-GGUF"
MODEL_FILE="DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf"

# 리스닝 포트 (경량 보조=8080, 14B 메인=8081 과 구분)
LLAMA_PORT="8080"

# 추론 파라미터
CTX_SIZE="16384"
THREADS="4"
# KV 캐시 양자화로 대역폭 절약 (선택). 버전 미지원시 빈 값.
KV_CACHE="q8_0"
# NO_THINK 는 여기선 효과 없음(DeepSeek-R1 은 훈련상 항상 생각). 억제 불가 -> 0 유지
NO_THINK="0"
PARALLEL="1"
BATCH="512"
UBATCH="512"
