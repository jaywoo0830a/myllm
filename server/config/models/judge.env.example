# Environment for the DeepSeek-R1-Distill-Qwen-14B (Judge / verifier)
# ----------------------------------------------------
# Role : 판사(Judge) — 논리적 일관성 검증 전용. GBNF 로 {ok,code} 초경량 출력.
# Load on-demand per PLAN.sh (14B, 단독 사용 시 ~11GB)
LLAMA_PORT=8092
LLAMA_HOST=0.0.0.0
MODEL_FILE=DeepSeek-R1-Distill-Qwen-14B-Q5_K_M.gguf
HF_REPO=unsloth/DeepSeek-R1-Distill-Qwen-14B-GGUF
# P3: 판사는 GBNF 로 20토큰 이하 출력 → 컨텍스트 축소로 KV 절감 (16384→8192)
CTX_SIZE=8192
THREADS=8
KV_CACHE=q8_0
# Q4_K_M 대신 Q5_K_M 로 14B 판정 — 메모리 대역폭 결합(M1)이므로 --parallel=1 단독 유지
PARALLEL=1
MODEL_NAME=judge
ALIAS=judge
