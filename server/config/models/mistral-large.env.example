# Environment for the Mistral-Small-24B-Instruct-2501 model
# ----------------------------------------------------
# Port on which llama-server will listen
LLAMA_PORT=8081

# Host address (0.0.0.0 = all interfaces)
LLAMA_HOST=0.0.0.0

# Path to the model GGUF file (absolute or relative to $MODEL_DIR)
# The default download script places the file under $HOME/models
MODEL_FILE=Mistral-Small-24B-Instruct-2501-Q4_K_M.gguf
# HuggingFace repository for the model GGUF
HF_REPO=unsloth/Mistral-Small-24B-Instruct-2501-GGUF

# Context size (tokens)
CTX_SIZE=65536

# Number of threads for generation (physical cores)
THREADS=8

# KV-Cache quantisation (optional – improves speed with minimal quality loss)
KV_CACHE=q8_0

# Model name for the OpenAI-compatible endpoint
MODEL_NAME=mistral-large

# Alias used by llama-server (appears in the OpenAI API response)
ALIAS=mistral-large