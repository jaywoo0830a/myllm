# Environment for the Qwen2.5-7B-Instruct worker model (instance 3)
# ----------------------------------------------------
LLAMA_PORT=8084
LLAMA_HOST=0.0.0.0
MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
HF_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
# P3: 워커는 요약뿐(max 500tok) → 컨텍스트 축소로 KV 절감 (16384→8192)
CTX_SIZE=8192
THREADS=8
KV_CACHE=q8_0
# 같은 GGUF(Qwen2.5-7B-Instruct) 공유: worker1~4 는 --parallel 슬롯으로 재사용 권장(M1)
PARALLEL=1
MODEL_NAME=worker3
ALIAS=worker3
