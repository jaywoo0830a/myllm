# ============================================================
# 모델 프로파일: DeepSeek-R1-Distill-Qwen-32B  (메인)
#   server/config/models/deepseek-r1-32b.env 로 복사해서 사용.
#   slug = deepseek-r1-32b
#
# 전역 config/env 를 source 한 뒤 이어서 로드된다 (같은 변수 덮어씀).
# ============================================================

# 모델 slug (systemd @인스턴스명, 파일명과 일치)
MODEL_NAME="deepseek-r1-32b"

# 표시용/API alias (llama-server --alias 로 /v1/models 에 노출)
ALIAS="deepseek-r1-32b"

# GGUF 정보 (unsloth 커뮤니티 GGUF; 공식 deepseek GGUF 리포는 비공개 401)
#   기존 Qwen3-14B 를 대체하는 32B dense reasoning. arch = qwen2 (안정)
#   파일 ≈ 19.9 GB. R1 distill: 항상 <think> 먼저 출력 (NO_THINK 불가)
HF_REPO="unsloth/DeepSeek-R1-Distill-Qwen-32B-GGUF"
MODEL_FILE="DeepSeek-R1-Distill-Qwen-32B-Q4_K_M.gguf"

# 리스닝 포트 (메인=8081, 경량 보조 1.5B=8080)
LLAMA_PORT="8081"

# 추론 파라미터
CTX_SIZE="16384"
# 32B dense 는 대역폭 병목 → 8코어에 8 스레드. 보조와 동시에 쓰면 속도 추가 저하.
THREADS="8"
# R1-32B: reasoning 항상 출력, 억제 불가 (NO_THINK=1 해도 llama.cpp 막을 수 없음) -> 0 유지
NO_THINK="0"
PARALLEL="1"
BATCH="512"
UBATCH="512"
