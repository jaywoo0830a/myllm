# ============================================================
# 모델 프로파일: Qwen3-14B  (메인)
#   server/config/models/qwen3-14b.env 로 복사해서 사용.
#   slug = qwen3-14b     ->  config/models/qwen3-14b.env
#
# 전역 config/env 를 source 한 뒤 이어서 로드된다 (같은 변수 덮어씀).
# ============================================================

# 모델 slug (systemd @인스턴스명, 파일명과 일치)
MODEL_NAME="qwen3-14b"

# 표시용/API alias (llama-server --alias 로 /v1/models 에 노출)
ALIAS="qwen3-14b"

# GGUF 정보 (공식 Qwen GGUF)
HF_REPO="Qwen/Qwen3-14B-GGUF"
MODEL_FILE="Qwen3-14B-Q4_K_M.gguf"

# 리스닝 포트 (14B 메인=8081)
LLAMA_PORT="8081"

# 추론 파라미터
CTX_SIZE="16384"
THREADS="8"        # 메인 모델에 코어 대부분 배정 (보조는 4)
NO_THINK="0"
PARALLEL="1"
BATCH="512"
UBATCH="512"
