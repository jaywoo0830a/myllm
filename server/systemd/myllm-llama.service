# ============================================================
# myllm-llama.service  --  llama.cpp llama-server systemd 유닛
#   03_run_server.sh 가 자체적으로 server/config/env 를 source 하므로
#   EnvironmentFile 은 불필요하다.
#   설치: bash 05_install_systemd.sh   (아래 {{ }} placeholder 자동 치환)
#   확인: systemctl status myllm-llama
#   로그: journalctl -u myllm-llama -f
# ============================================================
[Unit]
Description=myLLM llama.cpp OpenAI-compatible server (Qwen3.5-27B)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# placeholder 는 05_install_systemd.sh 가 사용자 경로로 치환합니다.
User={{USER}}
WorkingDirectory={{WORKDIR}}
ExecStart=/usr/bin/env bash {{RUN_SCRIPT}}
Restart=on-failure
RestartSec=5
# 모델 전체가 RAM 에 로드되므로 로드 시간(수십 초~수 분) 허용
TimeoutStartSec=infinity
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
