[Unit]
Description=myLLM llama-server Mistral-Small-24B (OpenAI 8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{SCRIPT_DIR}}
ExecStart=/usr/bin/env bash {{SCRIPT_DIR}}/llama_serve_mistral.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
