# ============================================================
# Continue.dev 전역 설정:  ~/.continue/config.yaml
#   (VS Code 의 Continue 확장이 사용하는 파일)
#
# 복사 방법 (이 클라이언트 머신에서):
#   cp client/continue/config.yaml.example ~/.continue/config.yaml
#   # 그 후 <서버IP>/모델명을 실제 값으로 편집
#
# 참고: config.yaml 이 현재 공식 형식. config.json/config.ts 는 구형.
# ============================================================

name: My Local DeepSeek-R1-14B
version: 1.0.0
schema: v1

# ============================================================
# 단일 모델: DeepSeek-R1-Distill-Qwen-14B  (llama-server, 포트 8081)
# model: 값은 llama-server 의 --alias (또는 /v1/models 보고값)와 일치해야 함.
#   curl http://<서버IP>:8081/v1/models
# ============================================================
models:
  - name: DeepSeek-R1 14B (로컬)
    provider: openai
    model: deepseek-r1-14b
    apiBase: http://<서버IP>:8081/v1
    apiKey: none
    # R1 reasoning 모델: 항상 <think> 먼저 출력 -> edit/apply(정확한 diff)엔 부적합.
    #   (edit/apply 를 시험해보고 싶으면 roles 주석 해제)
    roles:
      - chat
      # - edit
      # - apply
    defaultCompletionOptions:
      contextLength: 16384    # llama-server --ctx-size 와 맞출 것
      maxTokens: 4096
      temperature: 0.6
    autocompleteOptions:
      disable: true

# 참고: 탭 자동완성용 별도 FIM 모델을 추가하려면
# 아래처럼 roles 를 [autocomplete] 로 지정한 항목을 따로 넣는다.
#   - name: Tab Autocomplete
#     provider: openai
#     model: <fim-model-id>
#     apiBase: http://<서버IP>:8081/v1
#     apiKey: none
#     roles:
#       - autocomplete
