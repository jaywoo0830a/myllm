# ============================================================
# Continue.dev 전역 설정:  ~/.continue/config.yaml
#   (VS Code 의 Continue 확장이 사용하는 파일)
#
# 복사 방법 (이 클라이언트 머신에서):
#   cp client/continue/config.yaml.example ~/.continue/config.yaml
#   # 그 후 <서버IP>/모델명을 실제 값으로 편집
#
# 참고: config.yaml 이 현재 공식 형식. config.json/config.ts 는 구형.
# ============================================================

name: My Local Qwen
version: 1.0.0
schema: v1

models:
  - name: Qwen3.5 27B (llama.cpp)
    # llama-server 의 OpenAI 호환 /v1 을 쓰므로 provider 는 openai
    provider: openai
    # llama-server 가 /v1/models 에서 보고하는 모델 id(또는 --alias 로 지정한 이름)와 일치해야 함.
    # llama-server 기본값은 보통 "gpt-3.5-turbo" 가 아니라 입력 GGUF 기반 이름이나 --alias 값.
    # 확실하지 않으면:   curl http://<서버IP>:8080/v1/models   로 확인 후 여기에 그대로 입력.
    model: Qwen3.5-27B
    # 반드시 /v1 포함. Continue 는 여기에 chat/completions 등을 붙인다.
    apiBase: http://<서버IP>:8080/v1
    # llama.cpp 는 키를 무시하지만 Continue 가 Bearer 헤더로 보내므로 아무 값이나.
    apiKey: none
    # Qwen3.5-27B 는 FIM 자동완성 전용 모델이 아님 -> autocomplete 역할 제외
    roles:
      - chat
      - edit
      - apply
    defaultCompletionOptions:
      contextLength: 16384   # llama-server --ctx-size 와 맞출 것
      maxTokens: 2048
      temperature: 0.2
    # 혹시 탭 자동완성이 chat 모델로 잘못 발동하면 강제로 끔
    autocompleteOptions:
      disable: true

# 참고: 별도의 작은 FIM 자동완성 모델(예: Qwen Coder 계열)을 추가하려면
# 아래처럼 별도 항목을 만들고 roles 를 [autocomplete] 로 지정한다.
#   - name: Tab Autocomplete
#     provider: openai
#     model: <fim-model-id>
#     apiBase: http://<서버IP>:8080/v1
#     apiKey: none
#     roles:
#       - autocomplete
