# ============================================================
# Continue.dev 전역 설정:  ~/.continue/config.yaml
#   (VS Code 의 Continue 확장이 사용하는 파일)
#
# 복사 방법 (이 클라이언트 머신에서):
#   cp client/continue/config.yaml.example ~/.continue/config.yaml
#   # 그 후 <서버IP>/모델명을 실제 값으로 편집
#
# 참고: config.yaml 이 현재 공식 형식. config.json/config.ts 는 구형.
# ============================================================

name: My Local 2-Model (qwen3-14b + deepseek-1.5b)
version: 1.0.0
schema: v1

# ============================================================
# 두 모델을 병렬 서버(각각 포트)로 노출.
# model: 값은 llama-server 의 --alias (또는 /v1/models 보고값)와 일치해야 함.
#   curl http://<서버IP>:8081/v1/models   # qwen3-14b
#   curl http://<서버IP>:8080/v1/models   # deepseek
# ============================================================
models:
  # ---- 메인: Qwen3-14B (포트 8081) ----
  - name: Qwen3 14B (메인)
    provider: openai
    model: qwen3-14b
    apiBase: http://<서버IP>:8081/v1
    apiKey: none
    # dense 14B: 코드 편집(edit/apply)·복잡 추론에 적합
    roles:
      - chat
      - edit
      - apply
    defaultCompletionOptions:
      contextLength: 16384    # llama-server --ctx-size 와 맞출 것
      maxTokens: 4096
      temperature: 0.2
    autocompleteOptions:
      disable: true

  # ---- 보조: DeepSeek-R1-Distill-Qwen-1.5B (포트 8080) ----
  - name: DeepSeek-R1 1.5B (보조/빠른 채팅)
    provider: openai
    model: deepseek-r1-1.5b
    apiBase: http://<서버IP>:8080/v1
    apiKey: none
    # reasoning 모델: 긴 <think> 먼저 출력 -> edit/apply(정확한 diff)엔 덜 맞음.
    roles:
      - chat
    defaultCompletionOptions:
      contextLength: 16384
      maxTokens: 2048
      temperature: 0.6
    autocompleteOptions:
      disable: true

# 참고: 탭 자동완성용 별도 FIM 모델을 추가하려면
# 아래처럼 roles 를 [autocomplete] 로 지정한 항목을 따로 넣는다.
#   - name: Tab Autocomplete
#     provider: openai
#     model: <fim-model-id>
#     apiBase: http://<서버IP>:8081/v1
#     apiKey: none
#     roles:
#       - autocomplete
